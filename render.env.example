# MEP Backend \u2014 environment variables template
# Copy values into Render Dashboard > mep-backend > Environment
# (NEVER commit real values)

# --- Database (Render Postgres \u2014 use INTERNAL host, no port/sslmode tweaks needed beyond what Render gives) ---
ConnectionStrings__DefaultConnection=Host=dpg-xxxx-a.oregon-postgres.render.com;Database=mep_database;UserName=mep_admin;Password=***;SSL Mode=Require;Trust Server Certificate=true
# Chatbot read-only role does NOT exist on Render Postgres \u2014 point to same admin user for now,
# or create role mep_chatbot_ro after restore (script provided) and use it here.
ConnectionStrings__ChatbotDbConnection=Host=dpg-xxxx-a.oregon-postgres.render.com;Database=mep_database;UserName=mep_admin;Password=***;SSL Mode=Require;Trust Server Certificate=true

# --- JWT (generate a NEW 64-char random secret, e.g. openssl rand -base64 48) ---
Jwt__Key=REPLACE_WITH_NEW_RANDOM_SECRET

# --- AI ---
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=REPLACE_GEMINI_KEY
AI_MODEL=gemini-2.5-flash
GROQ_API_KEY=REPLACE_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (Gmail app password) ---
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SenderName=FAS-02 SYSTEM
EmailSettings__SenderEmail=REPLACE_GMAIL
EmailSettings__Password=REPLACE_APP_PASSWORD

# --- VietQR ---
VietQr__ApiBase=https://api.vietqr.io/v2
VietQr__BankCode=970422
VietQr__AccountNumber=REPLACE
VietQr__AccountName=REPLACE
VietQr__TemplateId=compact
VietQr__WebhookSecret=REPLACE_RANDOM

# --- Account settings ---
AccountSettings__RetentionDays=15

# --- CORS (Vercel FE URL after deploy; keep localhost for dev testing) ---
AllowedOrigins__0=http://localhost:3000
AllowedOrigins__1=https://REPLACE-VERCEL-APP.vercel.app

# --- Render runtime ---
DOTNET_VERSION=8.0
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
